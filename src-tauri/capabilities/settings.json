{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "settings-capability",
  "description": "Capability for the settings window",
  "windows": ["settings"],
  "permissions": [
    "core:default",
    "store:default",
    "dialog:default",
    "core:window:allow-minimize",
    "core:window:allow-close",
    "core:window:allow-start-dragging"
  ]
}
