{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "nothing-wallpaper",
  "version": "0.1.0",
  "identifier": "com.nothing.wallpaper",
  "build": {
    "beforeDevCommand": "bun run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "bun run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Nothing Wallpaper",
        "width": 1920,
        "height": 1080,
        "decorations": false,
        "transparent": true,
        "fullscreen": true,
        "skipTaskbar": true,
        "alwaysOnTop": false,
        "resizable": false,
        "shadow": false,
        "additionalBrowserArgs": "--disable-features=msWebOOUI,msPdfOOUI,msSmartScreenProtection,ElasticOverscroll,OverscrollHistoryNavigation,msExperimentalScrolling"
      },
      {
        "label": "settings",
        "title": "Nothing Wallpaper",
        "width": 720,
        "height": 520,
        "center": true,
        "resizable": false,
        "maximizable": false,
        "decorations": false,
        "transparent": true,
        "create": false,
        "additionalBrowserArgs": "--disable-features=msWebOOUI,msPdfOOUI,msSmartScreenProtection,ElasticOverscroll,OverscrollHistoryNavigation,msExperimentalScrolling"
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": ["**"]
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEJDNDk3MUY4MEZDODJCNUYKUldSZks4Z1ArSEZKdkw4c050VXhvYUdIRU43Lzk5aWx2VHVnM2ZXZGNSK01oM0ZwQzBySmRPRXkK",
      "endpoints": [
        "https://github.com/snvshal/nothing-wallpaper/releases/latest/download/latest.json"
      ]
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico",
      "icons/icon.png"
    ]
  }
}
